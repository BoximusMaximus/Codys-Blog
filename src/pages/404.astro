---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Christaphor Box" description="Page not found.">
  <section>
    <div class="mt-10 rounded-xl border border-white/10 p-6 sm:p-8 flex items-center justify-center bg-red-700/40">
        <h1 class="font-semibold text-4xl">404 Page not found!</h1>
    </div>
    <div class="mt-4 gap-4 flex items-center justify-center">
        <a href="/" class="group rounded-xl border border-white/10  p-5 transition hover:-translate-y-0.5 hover:border-emerald-400/40 hover:bg-zinc-900/80 sm:p-6">
        <h3 class=" text-2xl text-white sm:text-3xl">Click me to go home</h3>
      </a>
    </div>

  </section>
</BaseLayout>
