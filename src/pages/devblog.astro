---
import '../layouts/style.css';
import Navigation from "../components/Navigation.astro";
import { getCollection } from 'astro:content';
import DevblogCard from '../components/DevblogCard';


  const allBlogPosts = await getCollection("devblog")
  console.log(allBlogPosts)
---
<head>
    <meta charset="UTF-8">
    <title>Chris's Devlog</title>
</head>
<body>
    <div>
        <Navigation />
        <div>
            <ul>
            {allBlogPosts.map(post => (
                <li><DevblogCard devblogId={post.id} devblogDesc={post.data.description} devblogTitle={post.data.title} devblogDate=`${post.data.pubDate}`/></li>
            ))}
            </ul>
        </div>
    </div>
</body>